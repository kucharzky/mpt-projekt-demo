{
  "name": "smartuniplanner",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @smartuni/api\" \"npm run dev -w @smartuni/web\"",
    "dev:web": "npm run dev -w @smartuni/web",
    "dev:api": "npm run dev -w @smartuni/api",
    "build": "npm run build -w @smartuni/api && npm run build -w @smartuni/web",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint apps --max-warnings 0",
    "test": "npm run build -w @smartuni/api && node --test --test-concurrency=1 tests/*.test.mjs",
    "db:generate": "npm run db:generate -w @smartuni/api",
    "db:migrate": "npm run db:migrate -w @smartuni/api",
    "api:types": "npm run api:types -w @smartuni/api",
    "setup": "node scripts/setup.mjs",
    "start": "npm run start -w @smartuni/api",
    "format": "prettier --write apps tests scripts eslint.config.mjs package.json docker-compose.yml README.md GLOSSARY.md docs/adr docs/implementation-plan.md"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.46.0",
    "prisma": "^6.19.0",
    "nodemon": "^3.1.10"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "minimatch": "^11.0.1",
    "multer": "^2.5.0"
  },
  "dependencies": {
    "@nestjs/platform-express": "^11.1.0"
  }
}
