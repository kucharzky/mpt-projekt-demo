# Local development only. Copy to .env before starting Docker Compose.
# These values are not production credentials. Keep .env out of Git.
WEB_PORT=5173
POSTGRES_DB=smartuniplanner
POSTGRES_USER=smartuniplanner
POSTGRES_PASSWORD=local_development_only
POSTGRES_PORT=5432

POSTGRES_TEST_DB=smartuniplanner_test
POSTGRES_TEST_PORT=5433

# Local Node API. Keep credentials/ports in sync above.
# The API explicitly loads the root .env.
DATABASE_URL=postgresql://smartuniplanner:local_development_only@127.0.0.1:5432/smartuniplanner?schema=public
TEST_DATABASE_URL=postgresql://smartuniplanner:local_development_only@127.0.0.1:5433/smartuniplanner_test?schema=public

API_PORT=3001
APP_ORIGIN=http://localhost:5173
# npm run setup generates a random secret if this field is empty.
SESSION_SECRET=
